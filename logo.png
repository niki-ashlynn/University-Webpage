<?php include "connect.php"; ?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>BUC - Admin Login</title>
    <link rel="stylesheet" href="style.css">
    <script>
        // JavaScript Form Validation
        function validateForm() {
            let username = document.getElementById("username").value.trim();
            let password = document.getElementById("password").value.trim();

            if (username === "" || password === "") {
                alert("Both fields are required!");
                return false; // stop form submission
            }

            if (password.length < 4) {
                alert("Password must be at least 4 characters long.");
                return false;
            }

            return true; // allow form submission
        }
    </script>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="header-container">
            <img src="logo.png" alt="University Logo" class="logo">
            <div class="header-text">
                <h1>British University College</h1>
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav>
        <ul>
            <li><a href="index.html">Home</a></li>
            <li><a href="uniinfo.html">About us</a></li>
            <li><a href="login.php" class="active">Login</a></li>
            <li><a href="clubs.html">Clubs</a></li>
            <li><a href="events.html">Activities & events</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main>
        <h2>Admin Login</h2>
        <section class="content-box">
            <form method="POST" action="" onsubmit="return validateForm();">
                <label for="username">Username:</label><br>
                <input type="text" id="username" name="username" required><br><br>

                <label for="password">Password:</label><br>
                <input type="password" id="password" name="password" required><br><br>

                <button type="submit" name="login">Login</button>
            </form>

            <?php
            if (isset($_POST['login'])) {
                $username = $_POST['username'];
                $password = $_POST['password'];

                // Query the login table
                $sql = "SELECT * FROM login WHERE admin_username='$username' AND admin_password='$password'";
                $result = mysqli_query($conn, $sql);

                if (mysqli_num_rows($result) === 1) {
                    // Successful login → redirect to dashboard.php
                    header("Location: dashboard.php");
                    exit;
                } else {
                    echo "<p style='color:red;'>Invalid username or password.</p>";
                }
            }
            ?>
        </section>
    </main>

    <!-- Footer -->
    <footer>
